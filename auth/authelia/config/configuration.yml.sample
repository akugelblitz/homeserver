server:
  address: 'tcp://:9091/'
  endpoints:
    authz:
      forward-auth:
        implementation: 'ForwardAuth'
        authn_strategies:
          - name: 'HeaderAuthorization'
            schemes:
              - 'Basic'
              - 'Bearer'
          - name: 'CookieSession'

log:
  level: debug
  # file_path: '/config/authelia.%d.log'

theme: light

totp:
  issuer: authelia.com

authentication_backend:
  file:
    path: /config/users_database.yml
    password:
      algorithm: argon2id
      iterations: 1
      salt_length: 16
      parallelism: 8
      memory: 64

access_control:
  default_policy: deny
  networks:
  - name: 'internal'
    networks:
      - '10.0.0.0/8'
      - '100.0.0.0/8'
      - '172.69.0.0/16'
  rules:
    - domain:
      - 'kuma.<your_domain>'
      subject: 'oauth2:client:uptime-kuma'
      policy: 'one_factor'

    - domain:
      - 'homepage.<your_domain>'
      policy: bypass

    - domain:
      - '*.<your_domain>'
      policy: one_factor
      subject:
      - 'group:admin'

    - domain:
      - 'hoarder.<your_domain>'
      policy: one_factor
      subject:
      - 'group:user'

regulation:
  max_retries: 3
  find_time: '2m'
  ban_time: '5m'


password_policy:
  standard:
    enabled: false
    min_length: 8
    max_length: 0
    require_uppercase: false
    require_lowercase: false
    require_number: false
    require_special: false
  zxcvbn:
    enabled: false
    min_score: 2

identity_validation:
  reset_password:
    jwt_secret: ...
    jwt_lifespan: '5 minutes'
    jwt_algorithm: 'HS256'

session:
  name: authelia_session
  secret: ...
  expiration: 36000
  inactivity: 3600
  cookies:
    - domain: '<your_domain>'
      authelia_url: 'https://auth.<your_domain>'
      default_redirection_url: 'https://homepage.<your_domain>'


storage:
  encryption_key: ...
  postgres:
    address: 'tcp://postgres:5432'
    database: 'authelia'
    schema: 'public'
    username: 'authelia'
    password: 'authelia'
    timeout: '15s'

notifier:
  disable_startup_check: false
  smtp:
    address: 'smtp://mail.smtp2go.com:2525'
    username: 'mail.<your_domain>'
    password: ''
    sender: "TARS - Authelia <support@<your_domain>>"
    subject: "[Authelia] {title}"
  # filesystem:
  #   filename: /config/notification.txt

identity_providers:
  oidc:
    ## The other portions of the mandatory OpenID Connect 1.0 configuration go here.
    ## See: https://www.authelia.com/c/oidc
    jwks:
    - algorithm: 'RS256'

      key: |
        -----BEGIN PRIVATE KEY-----

        -----END PRIVATE KEY-----

    clients:
      - client_id: 'beszel'
        client_name: 'Beszel'
        client_secret: ''
        public: false
        authorization_policy: 'one_factor'
        redirect_uris:
          - 'https://beszel.<your_domain>/api/oauth2-redirect'
        scopes:
          - "groups"
          - "openid"
          - "profile"
          - "email"
        userinfo_signed_response_alg: "none"

      - client_id: 'portainer'
        client_name: 'Portainer'
        client_secret: ''
        public: false
        authorization_policy: 'one_factor'
        redirect_uris:
          - 'https://portainer.<your_domain>'
        scopes:
          - 'openid'
          - 'profile'
          - 'groups'
          - 'email'
        userinfo_signed_response_alg: 'none'
        token_endpoint_auth_method: client_secret_post

      - client_id: 'hoarder'
        client_name: 'Hoarder'
        client_secret: ''
        public: false
        authorization_policy: 'one_factor'
        redirect_uris:
          - 'https://hoarder.<your_domain>/api/auth/callback/custom'
        scopes:
          - "openid"
          - "profile"
          - "email"
        userinfo_signed_response_alg: "none"

      - client_id: 'uptime-kuma'
        client_name: 'Uptime Kuma'
        client_secret: ''
        public: false
        scopes:
          - 'authelia.bearer.authz'
        audience:
          - 'https://kuma.<your_domain>/'
          - 'https://traefik.<your_domain>/'
        grant_types:
          - 'client_credentials'
        requested_audience_mode: 'implicit'
        token_endpoint_auth_method: 'client_secret_basic'

      - client_id: 'open_webui'
        client_name: 'Open WebUI'
        client_secret: ''
        public: false
        authorization_policy: 'one_factor'
        redirect_uris:
          - 'https://chat.<your_domain>/oauth/oidc/callback'
        scopes:
          - 'openid'
          - 'profile'
          - 'groups'
          - 'email'
        userinfo_signed_response_alg: 'RS256'
